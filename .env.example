# ─────────────────────────────────────────────────────────────────────────────
# STEG Front Office — Environment Variables Reference
# Copy this file to `.env.local` for local development.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend base URL (server-side only) ───────────────────────────────────────
# Used by Next.js server components and API route handlers to proxy requests
# to the Spring Boot backend. NOT exposed to the browser.
# Example: http://localhost:8080 (local), https://api.steg.tn (production)
API_BASE_URL=http://localhost:8080

# ── WebSocket base URL (client-side, optional) ────────────────────────────────
# If omitted, derived from API_BASE_URL by protocol substitution
# (http→ws, https→wss). Only needed if API and WebSocket endpoints differ.
# Example: ws://localhost:8080 (local), wss://api.steg.tn (production)
# WS_BASE_URL=

# ── Session secret (server-side only) ─────────────────────────────────────────
# High-entropy string (≥32 characters) used to sign httpOnly session cookies
# that carry JWT tokens. Rotate on compromise or deployment.
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-in-production-at-least-32-chars

# ── Public application URL (optional) ──────────────────────────────────────────
# Absolute URL for OpenGraph meta tags and email redirects.
# If omitted, uses request origin in server components.
# Example: https://stages.steg.com.tn (production)
# NEXT_PUBLIC_APP_URL=

# ── Branding / Display (optional) ──────────────────────────────────────────────
# App name displayed in headers, title tags, etc.
NEXT_PUBLIC_APP_NAME=STEG Front Office

# Default locale if user preference unavailable
NEXT_PUBLIC_DEFAULT_LOCALE=fr
